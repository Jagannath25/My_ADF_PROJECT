{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFJagannathRasekar"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_azuredb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_azuredb'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sajagannath.dfs.core.windows.net/"
		},
		"LS_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sajagannath.dfs.core.windows.net/"
		},
		"LS_azuredb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "rasekarserver.database.windows.net"
		},
		"LS_azuredb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "empdb"
		},
		"LS_azuredb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "rasekarserver"
		},
		"trigger1_properties_MainPipeLine_parameters_controlTableName": {
			"type": "string",
			"defaultValue": "dbo.WatermarkTable"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DFJagannathRasekar_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"LS_azuredb_password": {
						"value": "[parameters('LS_azuredb_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_adls_properties_typeProperties_url": {
						"value": "[parameters('LS_adls_properties_typeProperties_url')]"
					},
					"LS_azuredb_properties_typeProperties_server": {
						"value": "[parameters('LS_azuredb_properties_typeProperties_server')]"
					},
					"LS_azuredb_properties_typeProperties_database": {
						"value": "[parameters('LS_azuredb_properties_typeProperties_database')]"
					},
					"LS_azuredb_properties_typeProperties_userName": {
						"value": "[parameters('LS_azuredb_properties_typeProperties_userName')]"
					},
					"trigger1_properties_MainPipeLine_parameters_controlTableName": {
						"value": "[parameters('trigger1_properties_MainPipeLine_parameters_controlTableName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}