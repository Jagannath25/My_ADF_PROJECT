											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT LastWatermarkValue FROM ',\n    pipeline().parameters.controlSchemaName,\n    '.',\n    pipeline().parameters.controlTableName,\n    ' WHERE SourceSchemaName = ''',\n    item().SourceSchemaName,\n    ''' AND SourceTableName = ''',\n    item().SourceTableName,\n    ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_azure",
