{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFJagannathRasekar"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sajagannath.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqltoazure.vault.azure.net/"
		},
		"LS_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sajagannath.dfs.core.windows.net/"
		},
		"LS_azuredb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "rasekarserver.database.windows.net"
		},
		"LS_azuredb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "empdb"
		},
		"LS_azuredb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "rasekarserver"
		},
		"trigger1_properties_MainPipeLine_parameters_controlTableName": {
			"type": "string",
			"defaultValue": "dbo.WatermarkTable"
		},
		"trigger1_properties_PL_Demo_main_parameters_controlTableName": {
			"type": "string",
			"defaultValue": "ctl_Watermark"
		},
		"trigger1_properties_PL_Demo_main_parameters_controlSchemaName": {
			"type": "string",
			"defaultValue": "control"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_servertoadls')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "readDataFromServer",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('select WatermarkValue from dbo.WatermarkTable where TableName=''',pipeline().parameters.tableName,'''')",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_azure",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "checkCount",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "readDataFromServer",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n    'SELECT COUNT(*) AS count FROM dbo.',\n    pipeline().parameters.tableName,\n    ' WHERE modifiedDate > ''',\n    activity('readDataFromServer').output.firstRow.WatermarkValue,\n    ''''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_azure",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "checkIfcountgreaterThanzero",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "checkCount",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('checkCount').output.firstRow.count, 0)",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "AppendNoDataResult",
									"type": "AppendVariable",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"variableName": "SummaryResult",
										"value": {
											"value": "@json(concat(\n'{\"tableName\":\"', pipeline().parameters.tableName,\n'\",\"runId\":\"', pipeline().RunId,\n'\",\"dataFactoryName\":\"', pipeline().DataFactory,\n'\",\"pipelineName\":\"', pipeline().Pipeline,\n'\",\"status\":\"No New Data\"',\n',\"previousWatermark\":\"', string(activity('readDataFromServer').output.firstRow.WatermarkValue),\n'\",\"rowsCopied\":\"0\"',\n',\"dataWritten\":\"0\"',\n',\"message\":\"No new records found. Copy was skipped and the watermark was unchanged.\"}'\n))",
											"type": "Expression"
										}
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "copyfromazuretoadls",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT * FROM dbo.',\n    pipeline().parameters.tableName,\n    ' WHERE modifiedDate > ''',\n    activity('readDataFromServer').output.firstRow.WatermarkValue,\n    ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_azure",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_adls_csv",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@pipeline().parameters.tableName",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "updateWatermark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "copyfromazuretoadls",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_azuredb",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "@concat(\n    'UPDATE dbo.WatermarkTable SET WatermarkValue = DATEADD(MINUTE, 330, SYSUTCDATETIME()) WHERE TableName = ''',\n    pipeline().parameters.tableName,\n    ''''\n)",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "AppendSuccessResult",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "updateWatermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "SummaryResult",
										"value": {
											"value": "@json(concat(\n'{\"tableName\":\"', pipeline().parameters.tableName,\n'\",\"runId\":\"', pipeline().RunId,\n'\",\"dataFactoryName\":\"', pipeline().DataFactory,\n'\",\"pipelineName\":\"', pipeline().Pipeline,\n'\",\"status\":\"Success\"',\n',\"previousWatermark\":\"', string(activity('readDataFromServer').output.firstRow.WatermarkValue),\n'\",\"rowsCopied\":\"', string(activity('copyfromazuretoadls').output.rowsCopied),\n'\",\"dataWritten\":\"', string(activity('copyfromazuretoadls').output.dataWritten),\n'\",\"message\":\"Data copied and watermark updated successfully.\"}'\n))",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "sendEmail",
						"type": "WebActivity",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": {
								"value": "@pipeline().globalParameters.logic_app_url",
								"type": "Expression"
							},
							"body": {
								"value": "@json(concat(\n'{\"email_recipient\":\"', pipeline().globalParameters.email,\n'\",\"subject\":\"ADF Pipeline Execution Report - Success\"',\n',\"status\":\"Success\"',\n',\"dataFactoryName\":\"', pipeline().DataFactory,\n'\",\"pipelineName\":\"', pipeline().Pipeline,\n'\",\"runId\":\"', pipeline().RunId,\n'\",\"tableName\":\"', pipeline().parameters.tableName,\n'\",\"previousWatermark\":\"', string(activity('readDataFromServer').output.firstRow.WatermarkValue),\n'\",\"rowsCopied\":\"', string(activity('copyfromazuretoadls').output.rowsCopied),\n'\",\"dataWritten\":\"', string(activity('copyfromazuretoadls').output.dataWritten),\n'\",\"message\":\"Incremental data copied from Azure SQL to ADLS Gen2 and watermark updated successfully.\"}'\n))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "sendEmailWithTableTemplate",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "checkIfcountgreaterThanzero",
								"dependencyConditions": [
