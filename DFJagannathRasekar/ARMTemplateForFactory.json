						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": {
								"value": "@pipeline().globalParameters.logic_app_url",
								"type": "Expression"
							},
							"body": {
								"value": "@json(concat(\n'{\"email_recipient\":\"', pipeline().globalParameters.email,\n'\",\"subject\":\"ADF Pipeline Execution Summary\"',\n',\"dataFactoryName\":\"', pipeline().DataFactory,\n'\",\"pipelineName\":\"', pipeline().Pipeline,\n'\",\"runId\":\"', pipeline().RunId,\n'\",\"tableResults\":', string(variables('SummaryResult')),\n'}'\n))",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"tableName": {
						"type": "String"
					}
				},
				"variables": {
					"SummaryResult": {
						"type": "Array"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-29T20:42:31Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_azure')]",
				"[concat(variables('factoryId'), '/datasets/DS_adls_csv')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_azuredb')]"
			]
		},
