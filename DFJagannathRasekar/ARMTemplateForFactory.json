										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT COUNT(*) AS count FROM [',\n    item().SourceSchemaName,\n    '].[',\n    item().SourceTableName,\n    '] WHERE [modifiedDate] > ''',\n    string(activity('readDataFromServer').output.firstRow.LastWatermarkValue),\n    ''''\n)",
												"type": "Expression"
